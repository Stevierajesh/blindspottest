{
  "schema_version": "1.0",
  "invariants": [
    {
      "id": "PERSISTENCE_001",
      "name": "Persistence Invariant",
      "description": "Successfully committed user-visible state should survive a reload or revisit.",
      "applies_to": [
        "persistent_mutation"
      ],
      "requirements": [
        "editable_target",
        "commit_action",
        "observable_post_commit_state"
      ],
      "procedure": [
        "observe_initial_value",
        "generate_mutation",
        "apply_mutation",
        "commit",
        "observe_success",
        "reload",
        "observe_final_value"
      ],
      "precondition": "success_observed == true",
      "expected_relation": "committed_value == final_value",
      "verification_strategy": "reload_and_compare",
      "on_violation": {
        "severity": "high",
        "summary": "A committed value did not survive a reload."
      },
      "teardown": [
        "restore_original_value",
        "commit_restore"
      ]
    },
    {
      "id": "PERSISTENCE_002",
      "name": "Autosave Persistence Invariant",
      "description": "State in a field that saves automatically should survive a reload without an explicit commit action.",
      "applies_to": [
        "persistent_mutation"
      ],
      "requirements": [
        "editable_target",
        "no_commit_action",
        "observable_post_commit_state"
      ],
      "procedure": [
        "observe_initial_value",
        "generate_mutation",
        "apply_mutation",
        "settle",
        "reload",
        "observe_final_value"
      ],
      "precondition": null,
      "expected_relation": "committed_value == final_value",
      "verification_strategy": "reload_and_compare",
      "on_violation": {
        "severity": "high",
        "summary": "A value in an autosaving field did not survive a reload."
      },
      "teardown": [
        "restore_original_value"
      ]
    }
  ]
}
